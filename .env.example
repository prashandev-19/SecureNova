# Copy this file to ".env" (same folder) and fill in your own values.
# Never share or screenshot the real .env: it holds client secrets.

AUTH0_DOMAIN=dev-xxxxxxxx.us.auth0.com
API_AUDIENCE=https://api.securenova.local

# Regular Web Application (AI chat service)
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=

# Second Regular Web Application (only needed to prove SSO)
WEB2_CLIENT_ID=
WEB2_CLIENT_SECRET=

# Machine-to-Machine application (AI agent)
M2M_CLIENT_ID=
M2M_CLIENT_SECRET=
